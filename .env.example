# Copy this file to .env before running a live evaluation.
# .env is ignored by Git and must never be committed.

# Foundry OpenAI v1 base URL (do not include /chat/completions)
AZURE_MODEL_ROUTER_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
AZURE_MODEL_ROUTER_KEY=your-model-router-api-key
AZURE_MODEL_ROUTER_DEPLOYMENT=model-router

# Foundry OpenAI v1 base URL for the baseline (do not include /responses)
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_KEY=your-azure-openai-api-key
# Must match a key in the pricing section of the config file you run (e.g. gpt-4o, gpt-5).
# If you use a custom deployment name, add a matching entry under pricing: in that same config
# using your exact deployment name. Otherwise baseline costs show as $0.00.
AZURE_BASELINE_DEPLOYMENT=gpt-5

# Judge model (defaults to the same Foundry OpenAI v1 base URL as the baseline)
AZURE_JUDGE_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
AZURE_JUDGE_KEY=your-azure-openai-api-key
AZURE_JUDGE_DEPLOYMENT=gpt-5

# ARM region of the Foundry resource, used to select matching Azure Retail
# Prices API meters (for example: eastus, swedencentral, westeurope).
AZURE_PRICING_REGION=eastus

# Microsoft Foundry (optional — for cloud evaluation via Foundry SDK)
AZURE_AI_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5
